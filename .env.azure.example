# NormNet inspector on Azure Container Apps.
#
# Setting AZURE_OPENAI_ENDPOINT is what switches the decision backend from the
# local Ollama option to the hosted deployment — agentic/llm.py reads exactly
# these names, and the UI then offers "Azure OpenAI" instead of "Ollama".
#
# On Container Apps the endpoint is a container-app secret
# (secretref:openai-endpoint), not plaintext here. There is no key: the app
# authenticates with its managed identity, which holds the Foundry User role on
# the account. Locally that means whatever `az login` identity you are running
# as needs the same role.

AZURE_OPENAI_ENDPOINT=https://aif-foundry-inno-d.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.5
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ── Local development instead of the above ───────────────────────────────────
# PETRI_OLLAMA_URL=http://127.0.0.1:11434
# PETRI_OLLAMA_MODEL=mistral-small3.1:24b
